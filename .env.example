# ==========================================
# Wardell Lead Engine — Configuration
# ==========================================

# Server & Environment
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_32_char_hex_encryption_key_for_oauth_tokens

# Database (PostgreSQL)
# Local Homebrew PostgreSQL or Docker Compose:
DATABASE_URL="postgresql://syahbintang@localhost:5432/wardell_leads?schema=public"

# Redis (BullMQ queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Outbound Email Safeguards & Dry-Run Mode
# When DRY_RUN is true, emails are simulated and NEVER dispatched to real inboxes
DRY_RUN=true
DEFAULT_DAILY_SEND_LIMIT=30
MIN_SEND_INTERVAL_SECONDS=45

# Google Cloud & Google Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Gmail OAuth 2.0 Credentials (for Sending Approved Emails)
GMAIL_CLIENT_ID=your_google_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback

# AI Provider Configuration (Google Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Alternative OpenAI configuration:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Timezone (Default for scheduling and business hours)
APP_TIMEZONE=Asia/Jakarta
